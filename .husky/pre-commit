#!/usr/bin/env sh
. "$(dirname "$0")/_/husky.sh"

# Pre-commit: Lint & format kontrolü ve test

if npx --no-install lint-staged; then
  echo "✅ Kod biçimi ve lint kontrolleri geçti."
else
  echo "⛔ Lint veya format hatası tespit edildi. Commit iptal edildi."
  exit 1
fi

# Testleri otomatik çalıştırmak için (isteğe bağlı, kapatmak için yoruma alabilirsiniz)
if npm run test; then
  echo "✅ Tüm testler geçti."
else
  echo "⛔ Testler başarısız! Commit iptal edildi."
  exit 1
fi
