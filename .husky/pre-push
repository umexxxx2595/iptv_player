#!/usr/bin/env sh
. "$(dirname "$0")/_/husky.sh"

# Pre-push: Doğrulama kontrolü ve ileri seviye test

REQUIRED_FILES="index.html package.json src/app.js src/bootstrap.js src/boot-loader.js"
for f in $REQUIRED_FILES; do
  if [ ! -f "$f" ]; then
    echo "⛔ Zorunlu dosya eksik: $f"
    exit 1
  fi
done

if npx --no-install lint-staged; then
  echo "✅ Kod biçimi ve lint kontrolleri push öncesi geçti."
else
  echo "⛔ Push öncesi lint/format hatası! Push iptal edildi."
  exit 1
fi

if npm run test; then
  echo "✅ Push öncesi tüm testler geçti."
else
  echo "⛔ Testler başarısız! Push iptal edildi."
  exit 1
fi
